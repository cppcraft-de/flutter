+void Run::commit() {
+    if (this->isPlaceholder()) {
+        return;
+    }
+
+    // [SCHOOLCRAFT] WSC uses integer glyph advances. Round each shaped advance
+    // independently, then rebuild positions so wrapping uses the same widths.
+    // Read the next original position before overwriting the current position.
+    // Rounding must never depend on whether original positions were retained.
+    SkScalar previousRawX = fPositions.empty() ? 0.0f : fPositions[0].fX;
+    SkScalar x = previousRawX;
+    SkScalar width = 0.0f;
+    for (size_t i = 0; i < this->size(); ++i) {
+        const SkScalar nextRawX = fPositions[i + 1].fX;
+        SkScalar advance = SkScalarRoundToInt(nextRawX - previousRawX);
+        previousRawX = nextRawX;
+        fPositions[i].fX = x;
+        x += advance;
+        width += advance;
+    }
+    if (!fPositions.empty()) {
+        fPositions[this->size()].fX = x;
+    }
+    fAdvance.fX = width;
+}
