diff --git a/modules/skparagraph/include/FontDiagnostics.h b/modules/skparagraph/include/FontDiagnostics.h
new file mode 100644
index 0000000000..109967639f
--- /dev/null
+++ b/modules/skparagraph/include/FontDiagnostics.h
@@ -0,0 +1,45 @@
+// Copyright 2026 Google LLC
+#ifndef FontDiagnostics_DEFINED
+#define FontDiagnostics_DEFINED
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+
+namespace skia {
+namespace textlayout {
+
+// One startup mode for all paragraphs and their shared shaping caches.
+// Bit 0 enables collection; bit 1 freezes configuration at the first builder.
+inline std::atomic<unsigned>& FontDiagnosticsState() {
+    static std::atomic<unsigned> state{[] {
+        const char* value = std::getenv("WSC_FONT_DIAGNOSTICS");
+        return value && (std::strcmp(value, "1") == 0 || std::strcmp(value, "true") == 0)
+                ? 1u : 0u;
+    }()};
+    return state;
+}
+
+inline bool FontDiagnosticsEnabled() {
+    return (FontDiagnosticsState().load(std::memory_order_relaxed) & 1u) != 0;
+}
+
+inline bool ConfigureFontDiagnostics(bool enabled) {
+    auto& state = FontDiagnosticsState();
+    unsigned previous = state.load(std::memory_order_relaxed);
+    while ((previous & 2u) == 0) {
+        if (state.compare_exchange_weak(previous, enabled ? 1u : 0u,
+                                       std::memory_order_relaxed)) {
+            return true;
+        }
+    }
+    return ((previous & 1u) != 0) == enabled;
+}
+
+inline void FreezeFontDiagnostics() {
+    FontDiagnosticsState().fetch_or(2u, std::memory_order_relaxed);
+}
+
+}  // namespace textlayout
+}  // namespace skia
+#endif  // FontDiagnostics_DEFINED
